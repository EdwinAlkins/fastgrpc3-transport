"""Types of the extension (`src/python.rs`)."""

SENT: int
FULL: int
CLOSED: int
TRANSPORT_API_VERSION: int

class Call:
    @property
    def id(self) -> int: ...
    @property
    def path(self) -> str: ...
    @property
    def body(self) -> bytes: ...
    @property
    def streaming(self) -> bool: ...
    @property
    def peer(self) -> str: ...
    def peer_identities(self) -> list[bytes] | None: ...
    def auth_context(self) -> dict[str, list[bytes]]: ...
    def send_initial_metadata(self, metadata: list[tuple[str, str | bytes]]) -> None: ...
    def set_trailing_metadata(self, metadata: list[tuple[str, str | bytes]]) -> None: ...
    def metadata(self) -> list[tuple[str, str | bytes]]: ...
    def time_remaining(self) -> float | None: ...
    def consumed(self) -> None: ...
    def reply(self, data: bytes) -> None: ...
    def try_send(self, data: bytes) -> int: ...
    def when_writable(self) -> None: ...
    def finish(self) -> None: ...
    def fail(self, code: int, message: str, details: bytes | None = None) -> None: ...

class Server:
    def __init__(
        self,
        threads: int = 1,
        stream_capacity: int = 16,
        max_concurrent_rpcs: int = 1024,
        admission_timeout: float = 0.0,
        *,
        max_recv_bytes: int | None = None,
        max_send_bytes: int | None = None,
        max_metadata_bytes: int | None = None,
        compression: str | None = None,
        keepalive: tuple[float, float] | None = None,
        reuse_port: bool = False,
        tls: tuple[bytes, bytes, bytes | None, bool] | None = None,
    ) -> None: ...
    def add_route(self, path: str, kind: str) -> None: ...
    def start_queue(self, port: int, host: str = "127.0.0.1") -> tuple[int, int]: ...
    def reply_many(self, answers: list[tuple[Call, bytes]]) -> None: ...
    def take(
        self, max_events: int = ...
    ) -> tuple[
        list[Call], list[int], list[tuple[int, bytes | None, int]], list[int], bool
    ]: ...
    def shutdown(self, grace: float = 0.0) -> None: ...
    def finished(self) -> bool: ...
    def join(self) -> None: ...
    def stop(self, grace: float = 0.0) -> None: ...
